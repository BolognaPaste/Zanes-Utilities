{
  "name": "zanes-utilities",
  "version": "1.0.0",
  "description": "Zane's Utilities",
  "author": "Zane",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "baseline": "node scripts/baseline.js",
    "verify:binaries": "node scripts/verify-binaries.js",
    "check": "npm run lint && npm run format:check && npm test",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev > sbom.cdx.json"
  },
  "build": {
    "appId": "com.zane.utilities",
    "npmRebuild": false,
    "electronLanguages": [
      "en-US"
    ],
    "copyright": "Copyright © Zane",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "productName": "Zanes Utilities",
    "files": [
      "main.js",
      "diagnostics.js",
      "logger.js",
      "preload.js",
      "driver-ipc.js",
      "drivers.js",
      "vendor-ipc.js",
      "vendor-sources.js",
      "vendor-ui.js",
      "shred-ipc.js",
      "shred-ui.js",
      "vault-ipc.js",
      "vault-ui.js",
      "video-ipc.js",
      "games-ipc.js",
      "games-ui.js",
      "fmhy-ipc.js",
      "fmhy-ui.js",
      "adblock.js",
      "lock-ipc.js",
      "lock-ui.js",
      "lock-boot.js",
      "video-ui.js",
      "phone-ipc.js",
      "phone-ui.js",
      "ssh-ipc.js",
      "ssh-sftp.js",
      "ssh-ui.js",
      "optimizer-ipc.js",
      "optimizer-ui.js",
      "chat-core.js",
      "chat-server.js",
      "chat-tunnel.js",
      "chat-remote.js",
      "chat-ipc.js",
      "chat-ui.js",
      "chat-web.html",
      "chat-web.js",
      "mumble-ipc.js",
      "chat.css",
      "test-ui.js",
      "efs-shim.js",
      "secure-store.js",
      "keystore.js",
      "secure-ls.js",
      "index.html",
      "cyber.css",
      "cyber.js",
      "bg.jpg",
      "build/icon.png",
      "app.js",
      "crash-core.js",
      "crash-worker.js",
      "adblock-worker.js",
      "lazy.js",
      "xml-deep.js",
      "ps/*.ps1",
      "scrcpy/**/*",
      "cloudflared/**/*",
      "mumble/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Zane's Utilities"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "scrcpy/**",
      "cloudflared/**",
      "mumble/**"
    ]
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.1",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "ffmpeg-static": "5.3.0",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.10.2",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.7.3"
  },
  "license": "GPL-3.0-or-later",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "ffmpeg-static@5.3.0": true,
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true
  }
}

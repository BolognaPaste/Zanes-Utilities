{
  "name": "zanes-utilities",
  "version": "1.0.0",
  "description": "Zane's Utilities",
  "author": "Zane",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.zane.utilities",
    "electronLanguages": [
      "en-US"
    ],
    "copyright": "Copyright © Zane",
    "productName": "Zanes Utilities",
    "files": [
      "main.js",
      "preload.js",
      "driver-ipc.js",
      "drivers.js",
      "vendor-ipc.js",
      "vendor-sources.js",
      "vendor-ui.js",
      "shred-ipc.js",
      "shred-ui.js",
      "vault-ipc.js",
      "vault-ui.js",
      "video-ipc.js",
      "games-ipc.js",
      "games-ui.js",
      "fmhy-ipc.js",
      "fmhy-ui.js",
      "adblock.js",
      "lock-ipc.js",
      "lock-ui.js",
      "lock-boot.js",
      "video-ui.js",
      "phone-ipc.js",
      "phone-ui.js",
      "ssh-ipc.js",
      "ssh-sftp.js",
      "ssh-ui.js",
      "optimizer-ipc.js",
      "optimizer-ui.js",
      "chat-core.js",
      "chat-server.js",
      "chat-tunnel.js",
      "chat-remote.js",
      "chat-ipc.js",
      "chat-ui.js",
      "chat-web.html",
      "chat-web.js",
      "mumble-ipc.js",
      "chat.css",
      "test-ui.js",
      "efs-shim.js",
      "index.html",
      "bg.jpg",
      "build/icon.png",
      "app.js",
      "ps/*.ps1",
      "scrcpy/**/*",
      "cloudflared/**/*",
      "mumble/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Zane's Utilities"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "scrcpy/**",
      "cloudflared/**",
      "mumble/**"
    ]
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.0.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "ffmpeg-static": "^5.2.0",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
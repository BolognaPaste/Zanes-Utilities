{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2023",
    "module": "nodenext",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["logger.js", "diagnostics.js", "scripts/**/*.js", "test/**/*.js"],
  "exclude": ["node_modules"]
}
